name = "clockinout"
main = "worker.js"
compatibility_date = "2026-10-23"

[assets]
directory = "./public"
binding = "ASSETS"
run_worker_first = ["/api/*"]

[[d1_databases]]
binding = "DB"
database_name = "clockinout-prod"
database_id = "REPLACE_WITH_D1_DATABASE_ID"

[vars]
TIME_ZONE = "Asia/Bangkok"
ALLOWED_ORIGIN = "https://REPLACE_WITH_YOUR_PAGES_DOMAIN"
